# Copy to .env. Local .env files are ignored by Git.
# Used by pnpm run setup; blank = hidden terminal prompt.
# After pairing, keep this blank or set it to the same bot's token.
TELEGRAM_BOT_TOKEN=

# paper simulates targets; live can execute targets you activate in Telegram.
# pnpm dev and pnpm start use this mode. --paper / --live overrides it.
BOT_MODE=paper

# Delay between monitor cycles, in milliseconds (1000-300000).
POLL_INTERVAL_MS=10000

# Optional. Blank uses the saved vault key or public FastNEAR endpoints.
FASTNEAR_API_KEY=

# Optional NEAR MAINNET HTTPS endpoints, in fallback order.
# Blank uses the built-in FastNEAR RPC endpoints.
NEAR_RPC_URLS=

# Optional passphrase for setup and unlocking; blank = hidden terminal prompt.
# Filling this stores the vault password in plaintext in this local file.
# Quote it if it contains # or leading/trailing spaces.
VAULT_PASSWORD=nearo

# Import seed/private keys with pnpm run import; they stay in the encrypted vault.
